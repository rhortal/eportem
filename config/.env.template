# ePortem credentials
EPORTEM_USERNAME=
EPORTEM_PASSWORD=

# Every YES/NO flag in this file is an exact match: only the exact text YES
# turns something on (yes, Yes, TRUE, 1 all count as off).

# Telegram bot settings
# Set TELEGRAM_NOTIFY=YES only once the token and chat id below are filled in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY=NO

# Slack settings
# SLACK_BOT_TOKEN: Bot User OAuth Token (xoxb-...), bot scope chat:write. It
#   sends SLACK_NOTIFY messages; they arrive in your DM with the app, from the
#   app, so Slack alerts you.
# SLACK_TOKEN: OAuth user token (xoxp-...), scope users.profile:write. Still
#   needed for SLACK_STATUS, and also used to find your user ID for the DM.
#   Without SLACK_BOT_TOKEN, a SLACK_TOKEN that also has the chat:write user
#   scope posts as you to your own DM, which arrives silently.
# SLACK_NOTIFY_CHANNEL: optional channel or user ID (C... / U...) to send
#   SLACK_NOTIFY messages to instead of your DM with the app.
# SLACK_WEBHOOK_URL: optional full Incoming Webhook URL
#   (https://hooks.slack.com/services/...). If set, it wins and SLACK_NOTIFY
#   messages go through it instead of the tokens. A token is not a valid webhook URL.
# Set SLACK_NOTIFY=YES only once SLACK_BOT_TOKEN (or SLACK_TOKEN, or
# SLACK_WEBHOOK_URL) is filled in, and SLACK_STATUS=YES only once SLACK_TOKEN is.
SLACK_NOTIFY=NO
SLACK_NOTIFY_CHANNEL=
SLACK_WEBHOOK_URL=
SLACK_STATUS=NO
SLACK_BOT_TOKEN=
SLACK_TOKEN=

# General configuration
# HEADLESS_BROWSING must be YES under cron; anything else opens a visible browser window.
# EPORTEM_ENABLED is a quiet off switch: anything other than exactly YES makes every
# run print one line and exit 0 without clocking (no cron mail, no alert).
# Failed cron runs and the --verify-day check send alerts on the channels enabled by
# TELEGRAM_NOTIFY / SLACK_NOTIFY above.
HEADLESS_BROWSING=YES
EPORTEM_ENABLED=YES
# Actions sent as a direct HTTP request instead of clicking through the browser
# (which then only logs in). YES/ALL, NO, or a list like lunch_break,after_lunch.
# If HTTP records nothing, the same run falls back to the browser.
EPORTEM_HTTP=NO
