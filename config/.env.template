# ePortem credentials
EPORTEM_USERNAME=
EPORTEM_PASSWORD=

# Telegram bot settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY=YES

# Slack settings
# SLACK_WEBHOOK_URL: full Incoming Webhook URL (https://hooks.slack.com/services/...),
#   used for SLACK_NOTIFY messages.
# SLACK_TOKEN: OAuth user token (xoxp-...), used for SLACK_STATUS updates
#   (requires the users.profile:write scope).
# These are two different Slack features - a webhook cannot set status,
# and a token is not a valid webhook URL.
SLACK_NOTIFY=YES
SLACK_WEBHOOK_URL=
SLACK_STATUS=YES
SLACK_TOKEN=

# General configuration
HEADLESS_BROWSING=YES
EPORTEM_ENABLED=YES

# Web UI configuration
WEB_UI_PORT=8010
