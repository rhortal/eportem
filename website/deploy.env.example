# Cloudflare credentials for website/deploy.sh. Copy to deploy.env (gitignored),
# then chmod 600 deploy.env.
#
# The ID of the Cloudflare account that owns the site (dashboard: Workers & Pages,
# right-hand column, "Account ID").
CLOUDFLARE_ACCOUNT_ID=
# A user API token with only this permission: Account > Cloudflare Pages > Edit,
# for that one account (My Profile > API Tokens > Create Token > Custom token).
CLOUDFLARE_API_TOKEN=
# The Pages project.
PAGES_PROJECT=checkin
