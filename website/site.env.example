# The public website's personal values. Copy to site.env (untracked) and fill in.
# `python website/build.py --example` builds a preview with these made-up ones.

# Where the site is published, without a trailing slash.
SITE_URL=https://checkin.example.com
# The person responsible for the site and the service (Spanish law, LSSI art. 10,
# and the GDPR controller).
OWNER_NAME=Alex Example
CONTACT_EMAIL=hello@example.com
# How long the web server keeps its access logs. Check this against the real host.
LOG_RETENTION_DAYS=14
# Optional now; needed once the service is offered for money.
OWNER_TAX_ID=
OWNER_ADDRESS=
# Optional: the network provider in front of the site (a CDN or proxy that sees
# visitors' IP addresses), named in the privacy policy. Empty: none mentioned.
NETWORK_PROVIDER=Cloudflare
