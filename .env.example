# ePortem service settings. Copy to .env and fill in; every line is optional
# except EPORTEM_SECRET_KEY. Generated by `python -m eportem config docs`:
# don't edit by hand. Secrets can also come from files: EPORTEM_<NAME>_FILE.
# Settings can also live in a TOML file named by EPORTEM_CONFIG_FILE.

# --- Server
# The address people use to reach this instance, e.g. https://eportem.example.com. Used in links and emails. Default: http://localhost:<port>.
EPORTEM_PUBLIC_URL=
# Address to listen on inside the container.
EPORTEM_HOST=0.0.0.0
# Port to listen on (web UI, API, admin, health, metrics).
EPORTEM_PORT=8080
# Reverse proxies whose X-Forwarded-* headers are believed (comma-separated IPs or CIDRs).
EPORTEM_TRUSTED_PROXIES=
# Send cookies only over HTTPS. Default: on when the public URL is https.
EPORTEM_SECURE_COOKIES=
# Serve under a sub-path, e.g. /eportem, behind a proxy.
EPORTEM_ROOT_PATH=

# --- Storage
# Where the database, backups and diagnostics live.
EPORTEM_DATA_DIR=/data
# SQLAlchemy URL. Default: SQLite in the data dir. Postgres (postgresql+psycopg://...) is needed for more than one replica.
EPORTEM_DATABASE_URL=
# Required. Encrypts stored credentials and tokens (a Fernet key: `python -m eportem config new-key`). Losing it means everyone re-enters their credentials.
EPORTEM_SECRET_KEY=
# Previous secret keys, still accepted for reading while rotating (comma-separated).
EPORTEM_OLD_SECRET_KEYS=

# --- Target site
# The ePortem site to automate. Point it at the fake ePortem for trying things out.
EPORTEM_TARGET_URL=https://eportem.es
# Override the browser's User-Agent. Default: a desktop Chrome matching the installed version.
EPORTEM_BROWSER_USER_AGENT=
# Chromium binary, if not on the PATH.
EPORTEM_CHROMIUM_PATH=
# chromedriver binary, if not on the PATH.
EPORTEM_CHROMEDRIVER_PATH=
# Browser logins allowed at the same time.
EPORTEM_BROWSER_CONCURRENCY=1
# Run the browser without a window.
EPORTEM_HEADLESS=true
# Use Chromium's own sandbox. The Docker image turns it off (it can't start as a non-root user there; the container isolates it instead).
EPORTEM_BROWSER_SANDBOX=true

# --- Defaults for new users
# Time zone for new users.
EPORTEM_DEFAULT_TIMEZONE=Europe/Madrid
# Language for new users.
EPORTEM_DEFAULT_LOCALE=es
# Country for public holidays (ISO code); empty for none.
EPORTEM_DEFAULT_HOLIDAY_COUNTRY=ES
# Region for public holidays, e.g. MD (Madrid), CT (Catalonia).
EPORTEM_DEFAULT_HOLIDAY_REGION=
# Working-day template for new users (a built-in key).
EPORTEM_DEFAULT_TEMPLATE=european-9-18
# Random offset for new users: start up to this many minutes before an action's time. Each person changes their own in their profile.
EPORTEM_DEFAULT_JITTER_BEFORE_MINUTES=5
# Random offset for new users: start up to this many minutes after an action's time.
EPORTEM_DEFAULT_JITTER_AFTER_MINUTES=4

# --- Scheduling
# An action may run this many minutes either side of its time, never later. Everyone's random offset must fit inside it.
EPORTEM_WINDOW_MINUTES=15
# The end-of-day check runs this long after a user's last action.
EPORTEM_VERIFY_AFTER_MINUTES=40
# Plan and log, but never send a clock action.
EPORTEM_DRY_RUN=false

# --- Accounts
# Who can create an account: closed (admins only), invite, open.
EPORTEM_REGISTRATION=closed
# New accounts must confirm their email.
EPORTEM_REQUIRE_EMAIL_VERIFICATION=true
# Creates this admin on first start, if no admin exists.
EPORTEM_ADMIN_USERNAME=
# Email of that first admin.
EPORTEM_ADMIN_EMAIL=
# Password of that first admin.
EPORTEM_ADMIN_PASSWORD=

# --- Email
# SMTP server for verification, password reset and alerts. Empty: no email.
EPORTEM_SMTP_HOST=
# SMTP port.
EPORTEM_SMTP_PORT=587
# starttls, tls (implicit, usually port 465) or none.
EPORTEM_SMTP_SECURITY=starttls
# SMTP login.
EPORTEM_SMTP_USERNAME=
# SMTP password.
EPORTEM_SMTP_PASSWORD=
# From address for the emails this instance sends.
EPORTEM_SMTP_FROM=

# --- Observability
# Log level.
EPORTEM_LOG_LEVEL=INFO
# Log lines as JSON or plain text.
EPORTEM_LOG_FORMAT=json
# Bearer token required on /metrics. Empty: /metrics is off.
EPORTEM_METRICS_TOKEN=
# Report errors to Sentry or GlitchTip. Empty: off.
EPORTEM_SENTRY_DSN=
# Environment name in error reports.
EPORTEM_SENTRY_ENVIRONMENT=production
# Pinged every minute while the scheduler is healthy (healthchecks.io style), so a dead instance gets noticed.
EPORTEM_HEARTBEAT_URL=
# Where admin alerts go, e.g. telegram:<chat id> or slack:<channel id>.
EPORTEM_ADMIN_ALERT_CHANNEL=

# --- Docker Compose only (not read by the service)
# Where the published port listens on the host. The default keeps it local;
# put a reverse proxy in front for HTTPS, or use 0.0.0.0:8080 on a trusted LAN.
EPORTEM_PUBLISH=127.0.0.1:8080

# --- GlitchTip (docker compose --profile errors; not read by the service)
# GLITCHTIP_SECRET_KEY: `openssl rand -hex 32`. GLITCHTIP_DOMAIN: its public address.
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=http://127.0.0.1:8000
GLITCHTIP_PUBLISH=127.0.0.1:8000
GLITCHTIP_FROM_EMAIL=glitchtip@example.com
GLITCHTIP_EMAIL_URL=consolemail://

